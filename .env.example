SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Inside docker-compose, "db" and "redis" are the service names, resolved via Docker's
# internal DNS — not localhost, since this runs in a separate container.
DATABASE_URL=postgres://vaultis:vaultis@db:5432/vaultis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Throttle counters. Separate Redis database from Celery's (0).
CACHE_URL=redis://redis:6379/1

CORS_ALLOWED_ORIGINS=

# json (default, for shipping logs somewhere) or plain (easier to read in a terminal)
LOG_FORMAT=json

# Bearer token required by /metrics. Leave empty to serve it only while DEBUG is on.
METRICS_TOKEN=

# Password for Grafana's admin account (local dev default: admin)
GRAFANA_ADMIN_PASSWORD=admin
